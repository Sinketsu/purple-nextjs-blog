{
    "extends": [
        "stylelint-config-standard",
        "stylelint-order-config-standard"
    ],
    "plugins": [
        "stylelint-order",
        "@stylistic/stylelint-plugin"
    ],
    "rules": {
        "selector-class-pattern": null,
        "@stylistic/indentation": "tab",
        "@stylistic/color-hex-case": "upper"
    }
}
